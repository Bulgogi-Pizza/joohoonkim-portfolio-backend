# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# SSL Certificate Email
CERTBOT_EMAIL=your-email@example.com

# Security
SECRET_KEY=your-secret-key-here
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password
# X-API-Key 헤더로 관리자 API 호출 시 사용할 키 (쉼표로 여러 개 가능)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=your_api_key

# Frontend Origin (will be set by deployment)
# 여러 origin을 쉼표로 구분하여 설정 가능
# 예: FRONTEND_ORIGIN=http://localhost:5173,https://main.example.com,https://dev.example.com
FRONTEND_ORIGIN=http://localhost:5173

# AWS Configuration
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2
